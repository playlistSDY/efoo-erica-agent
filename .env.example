# Copy to .env. Never commit .env or expose this key in frontend JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATA_DIR=data
# Empty = local SQLite. PostgreSQL must have pgvector installed.
DATABASE_URL=
# Example: postgresql://efoo:YOUR_PASSWORD@127.0.0.1:5432/efoo
# For compose.postgres.yaml only: POSTGRES_PASSWORD=YOUR_LOCAL_DB_PASSWORD
RAW_S3_BUCKET=
MIN_SIMILARITY=0.30
MAX_DATA_AGE_HOURS=24
# Public meal refresh: registered menus, empty snapshots, and failed attempts
# have separate refresh/retry intervals. Date ranges are inclusive.
MAX_DATE_RANGE_DAYS=31
MEAL_REFRESH_HOURS=6
MEAL_EMPTY_REFRESH_MINUTES=60
REFRESH_RETRY_MINUTES=5
# Process-local scheduler: use a single API worker while enabled.
# Starts with one background check, then waits this interval after each run.
# Default range is today through 13 days later (Asia/Seoul).
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_START_OFFSET_DAYS=0
SCHEDULE_DAYS=14
# Allow the model to choose conversation, clarification or campus tools.
# Each request has an independent bounded tool loop.
AGENTIC_ENABLED=true
AGENTIC_MAX_TURNS=5
